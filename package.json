{
  "name": "apted",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cd extension && npm install && npm run build && cd .. && next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:migrate-one": "tsx --env-file=.env.local scripts/migrate-one.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "backfill-pdfs": "tsx --env-file=.env.local scripts/backfill-pdfs.ts",
    "benchmark": "tsx --env-file=.env.local scripts/benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@stripe/stripe-js": "^9.12.0",
    "better-auth": "^1.6.23",
    "lucide-react": "^1.23.0",
    "next": "^15.1.0",
    "openai": "^6.42.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stripe": "^22.3.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
