# Supabase Postgres connection string.
# Use the "Transaction" pooler (port 6543) for serverless-style workloads:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Or the "Session" pooler (5432) / direct connection (5432) for long-lived clients.
# Find it under: Supabase dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Anthropic API key (server-side only, never exposed to the client)
ANTHROPIC_API_KEY=sk-ant-...

# Bearer token gating /api/* — required for the extension to hit the deployed
# API. When unset (typical for local dev), the auth check is skipped.
# Generate with: openssl rand -hex 32
APTED_AUTH_TOKEN=

# Compile service base URL (the Tectonic container service).
# In dev this is typically http://localhost:8080.
COMPILE_SERVICE_URL=http://localhost:8080
