# Supabase Postgres connection string.
# Use the "Transaction" pooler (port 6543) for serverless-style workloads:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Or the "Session" pooler (5432) / direct connection (5432) for long-lived clients.
# Find it under: Supabase dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# --- LLM provider selection -------------------------------------------------
# Which model backend the resume flows use: anthropic | openai | gemini.
# Defaults to anthropic if unset.
LLM_PROVIDER=opencode

# Per-provider model overrides (optional — sensible defaults are baked in:
# anthropic=claude-opus-4-8, openai=gpt-4.1-nano, gemini=gemini-2.0-flash-lite).
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4.1-nano
GEMINI_MODEL=gemini-2.0-flash-lite
DEEPSEEK_MODEL=deepseek-chat

# Optional per-flow provider overrides. Each falls back to LLM_PROVIDER if unset.
# Lets you run quality-sensitive tailoring on one model and the simpler,
# schema-bounded flows on a cheaper one. Values: anthropic | openai | gemini.
LLM_PROVIDER_TAILOR=
LLM_PROVIDER_EDIT=
LLM_PROVIDER_IMPORT=
LLM_PROVIDER_PARSE_PROSE=

# How many relevant prior tailored versions /api/tailor sends as framing hints
# (ranked by JD overlap). Defaults to 5.
TAILOR_RELEVANT_VERSIONS=5

# Which ranker to use for selecting relevant prior versions:
#   (unset) — keyword/tag overlap (default, no API cost)
#   embeddings — OpenAI text-embedding-3-small cosine similarity (opt-in)
# When set to embeddings, requires OPENAI_API_KEY.
TAILOR_RANKER=

# API keys (server-side only, never exposed to the client). You only need the
# key for the provider(s) you select or benchmark.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
DEEPSEEK_API_KEY=sk-...

# OpenCode Zen — OpenAI-compatible proxy that routes to different providers
# based on the model ID (claude-sonnet-4-5, deepseek-v4-flash).
# When OPENCODE_API_KEY is set, this becomes the default provider for all flows.
# Tailor uses Sonnet via OpenCode; structure selection uses DeepSeek v4 flash.
# Get your key at https://opencode.ai
OPENCODE_API_KEY=opc-...
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_TAILOR_MODEL=claude-sonnet-4-5
# OPENCODE_STRUCTURE_MODEL=deepseek-v4-flash

# Bearer token gating /api/*. LEGACY single-user gate (PRE-86).
#
# When Better Auth is enabled (BETTER_AUTH_SECRET set) you MUST leave this
# UNSET: the Chrome extension sends a Better Auth session token here, and this
# legacy check would 401 the extension before the route validates the session.
# Only set this for non-auth deployments that still want a static API gate.
# Generate with: openssl rand -hex 32
APTED_AUTH_TOKEN=

# Comma-separated allowed CORS origins. Defaults to "*" when unset.
# In production, set to the Chrome extension origin + Vercel domain:
#   ALLOWED_ORIGINS=chrome-extension://<your-extension-id>,https://apted.vercel.app
ALLOWED_ORIGINS=

# Compile service base URL (the Tectonic container service).
# In dev this is typically http://localhost:8080.
COMPILE_SERVICE_URL=http://localhost:8080

# --- Better Auth -----------------------------------------------------------
# When BETTER_AUTH_SECRET is unset, auth is disabled and every API route runs
# in a single-user "local" mode (user_id = "local") — frictionless dev/tests.
# Set it (and the OAuth vars) to enable real multi-tenant auth.
# IMPORTANT: once you set BETTER_AUTH_SECRET, unset APTED_AUTH_TOKEN (see below)
# or the extension's Better Auth bearer token will be 401'd by the legacy gate.
# NEVER rotate BETTER_AUTH_SECRET in prod without invalidating every session.
BETTER_AUTH_SECRET=  # generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000  # production: https://apted.vercel.app (your deploy URL)
# Mirror of "is BETTER_AUTH_SECRET set?" as a NEXT_PUBLIC_ var so the client
# bundle sees the same auth-enabled boolean as the server (avoids React
# hydration mismatch in AppShell). Set to "1" whenever BETTER_AUTH_SECRET is
# set; leave unset when it isn't. Safe to expose — it's just a boolean flag.
NEXT_PUBLIC_AUTH_ENABLED=

# Google OAuth (optional — leave blank to disable Google sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — leave blank to disable GitHub sign-in).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe payments (PRE-93) -----------------------------------------------
# Optional: leave all unset for local dev (the /upgrade page + checkout return
# 503 "payments_not_configured" and rate-limiting still runs via the trial/free
# tiers). Set all four to enable real checkout + webhooks.
#
# Two products in the Stripe dashboard:
#   - Monthly subscription: $9.99/mo recurring  → STRIPE_MONTHLY_PRICE_ID
#   - One-time payment:     $24.99 / 90 days    → STRIPE_3MONTH_PRICE_ID
# Create a webhook endpoint pointing at /api/stripe/webhook and copy its
# signing secret into STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_3MONTH_PRICE_ID=price_...
# --- Rate-limit tuning (PRE-93) ----------------------------------------------
# Tailor-session ceilings. BYOK users on trial/pro are UNCAPPED (their tokens);
# these only bind APP-SUBSIDIZED users running tailor on a server-side key.
#   - trial: cap across the 3 no-card days (bounds trial token CAC)
#   - pro:   monthly fair-use cap (positive margin on $9.99)
#   - free:  the upsell lever (BYOK on free does NOT unlock unlimited)
# The hourly velocity throttle applies to EVERYONE incl BYOK (anti-abuse).
# All overridable without a redeploy.
TRIAL_SUBSIDIZED_TAILOR_LIMIT=25
PRO_SUBSIDIZED_TAILOR_LIMIT=60
MAX_TAILOR_PER_HOUR=10
# Public app URL for Stripe success/cancel redirects. Defaults to
# BETTER_AUTH_URL (or http://localhost:3000 in dev). Set in prod.
NEXT_PUBLIC_APP_URL=https://apted.vercel.app
